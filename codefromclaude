import React, { useState } from 'react';
import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';
import { Plus, Save, Trash2, ChevronDown, ChevronUp } from 'lucide-react';

const exerciseLibrary = {
  fullBody: {
    compound: [
      { id: 1, name: 'Squats', category: 'Legs', sets: '3-4', reps: '8-12' },
      { id: 2, name: 'Bench Press', category: 'Push', sets: '3-4', reps: '8-12' },
      { id: 3, name: 'Deadlifts', category: 'Pull', sets: '3-4', reps: '8-12' },
      { id: 4, name: 'Overhead Press', category: 'Push', sets: '3', reps: '8-12' },
      { id: 5, name: 'Bent Over Rows', category: 'Pull', sets: '3', reps: '8-12' }
    ],
    isolation: [
      { id: 6, name: 'Bicep Curls', category: 'Arms', sets: '3', reps: '12-15' },
      { id: 7, name: 'Tricep Extensions', category: 'Arms', sets: '3', reps: '12-15' },
      { id: 8, name: 'Lateral Raises', category: 'Shoulders', sets: '3', reps: '12-15' }
    ]
  },
  pushPullLegs: {
    push: [
      { id: 9, name: 'Bench Press', category: 'Chest', sets: '4', reps: '8-12' },
      { id: 10, name: 'Overhead Press', category: 'Shoulders', sets: '3', reps: '8-12' },
      { id: 11, name: 'Incline Dumbbell Press', category: 'Chest', sets: '3', reps: '8-12' },
      { id: 12, name: 'Lateral Raises', category: 'Shoulders', sets: '3', reps: '12-15' },
      { id: 13, name: 'Tricep Pushdowns', category: 'Arms', sets: '3', reps: '12-15' }
    ],
    pull: [
      { id: 14, name: 'Deadlifts', category: 'Back', sets: '4', reps: '6-10' },
      { id: 15, name: 'Pull-ups/Lat Pulldowns', category: 'Back', sets: '3', reps: '8-12' },
      { id: 16, name: 'Barbell Rows', category: 'Back', sets: '3', reps: '8-12' },
      { id: 17, name: 'Face Pulls', category: 'Shoulders', sets: '3', reps: '12-15' },
      { id: 18, name: 'Bicep Curls', category: 'Arms', sets: '3', reps: '12-15' }
    ],
    legs: [
      { id: 19, name: 'Squats', category: 'Legs', sets: '4', reps: '8-12' },
      { id: 20, name: 'Romanian Deadlifts', category: 'Legs', sets: '3', reps: '8-12' },
      { id: 21, name: 'Leg Press', category: 'Legs', sets: '3', reps: '10-15' },
      { id: 22, name: 'Calf Raises', category: 'Legs', sets: '4', reps: '12-15' },
      { id: 23, name: 'Leg Extensions', category: 'Legs', sets: '3', reps: '12-15' }
    ]
  }
};

const WorkoutPlanner = () => {
  const [step, setStep] = useState(1);
  const [sessionsPerWeek, setSessionsPerWeek] = useState('');
  const [sessionDuration, setSessionDuration] = useState('');
  const [planType, setPlanType] = useState('');
  const [customPlan, setCustomPlan] = useState([]);
  const [generatedPlan, setGeneratedPlan] = useState(null);

  const generateWorkoutPlan = () => {
    let plan;
    switch (planType) {
      case 'fullBody':
        plan = generateFullBodyPlan();
        break;
      case 'pushPullLegs':
        plan = generatePPLPlan();
        break;
      case 'custom':
        plan = { type: 'Custom', exercises: customPlan };
        break;
      default:
        return;
    }
    setGeneratedPlan(plan);
    setStep(4);
  };

  const generateFullBodyPlan = () => {
    const daysPerWeek = parseInt(sessionsPerWeek);
    return {
      type: 'Full Body',
      schedule: Array(daysPerWeek).fill().map((_, i) => ({
        day: i + 1,
        compound: exerciseLibrary.fullBody.compound.slice(0, 3),
        isolation: exerciseLibrary.fullBody.isolation.slice(0, 2)
      }))
    };
  };

  const generatePPLPlan = () => {
    const daysPerWeek = parseInt(sessionsPerWeek);
    const schedule = [];
    for (let i = 0; i < daysPerWeek; i++) {
      const day = i % 3;
      if (day === 0) schedule.push({ type: 'Push', exercises: exerciseLibrary.pushPullLegs.push });
      if (day === 1) schedule.push({ type: 'Pull', exercises: exerciseLibrary.pushPullLegs.pull });
      if (day === 2) schedule.push({ type: 'Legs', exercises: exerciseLibrary.pushPullLegs.legs });
    }
    return { type: 'Push Pull Legs', schedule };
  };

  return (
    <div className="max-w-2xl mx-auto p-4">
      {step === 1 && (
        <Card className="mb-6">
          <CardHeader>
            <CardTitle>Step 1: Training Frequency</CardTitle>
          </CardHeader>
          <CardContent>
            <div className="space-y-4">
              <div>
                <label className="block text-sm font-medium mb-2">
                  How many times per week would you like to train?
                </label>
                <input
                  type="number"
                  min="1"
                  max="7"
                  value={sessionsPerWeek}
                  onChange={(e) => setSessionsPerWeek(e.target.value)}
                  className="border rounded-md p-2 w-full"
                />
              </div>
              {sessionsPerWeek && (
                <button
                  onClick={() => setStep(2)}
                  className="bg-blue-500 text-white px-4 py-2 rounded-md hover:bg-blue-600 transition-colors"
                >
                  Next
                </button>
              )}
            </div>
          </CardContent>
        </Card>
      )}

      {step === 2 && (
        <Card className="mb-6">
          <CardHeader>
            <CardTitle>Step 2: Session Duration</CardTitle>
          </CardHeader>
          <CardContent>
            <div className="space-y-4">
              <div>
                <label className="block text-sm font-medium mb-2">
                  How long would you like each session to be? (minutes)
                </label>
                <input
                  type="number"
                  min="15"
                  max="180"
                  step="15"
                  value={sessionDuration}
                  onChange={(e) => setSessionDuration(e.target.value)}
                  className="border rounded-md p-2 w-full"
                />
              </div>
              <div className="space-x-4">
                <button
                  onClick={() => setStep(1)}
                  className="bg-gray-500 text-white px-4 py-2 rounded-md hover:bg-gray-600 transition-colors"
                >
                  Back
                </button>
                {sessionDuration && (
                  <button
                    onClick={() => setStep(3)}
                    className="bg-blue-500 text-white px-4 py-2 rounded-md hover:bg-blue-600 transition-colors"
                  >
                    Next
                  </button>
                )}
              </div>
            </div>
          </CardContent>
        </Card>
      )}

      {step === 3 && (
        <Card className="mb-6">
          <CardHeader>
            <CardTitle>Step 3: Choose Your Plan Type</CardTitle>
          </CardHeader>
          <CardContent>
            <div className="space-y-4">
              <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                <button
                  onClick={() => {
                    setPlanType('fullBody');
                    generateWorkoutPlan();
                  }}
                  className="p-4 border rounded-md hover:bg-gray-50 transition-colors text-left"
                >
                  <h3 className="font-semibold">Full Body</h3>
                  <p className="text-sm text-gray-600">
                    Complete body workout in each session
                  </p>
                </button>
                <button
                  onClick={() => {
                    setPlanType('pushPullLegs');
                    generateWorkoutPlan();
                  }}
                  className="p-4 border rounded-md hover:bg-gray-50 transition-colors text-left"
                >
                  <h3 className="font-semibold">Push Pull Legs</h3>
                  <p className="text-sm text-gray-600">
                    Split training focusing on movement patterns
                  </p>
                </button>
                <button
                  onClick={() => {
                    setPlanType('custom');
                    setStep(4);
                  }}
                  className="p-4 border rounded-md hover:bg-gray-50 transition-colors text-left"
                >
                  <h3 className="font-semibold">Build Custom Plan</h3>
                  <p className="text-sm text-gray-600">
                    Create your own workout routine
                  </p>
                </button>
              </div>
              <button
                onClick={() => setStep(2)}
                className="bg-gray-500 text-white px-4 py-2 rounded-md hover:bg-gray-600 transition-colors"
              >
                Back
              </button>
            </div>
          </CardContent>
        </Card>
      )}

      {step === 4 && generatedPlan && (
        <Card className="mb-6">
          <CardHeader>
            <CardTitle>Your {generatedPlan.type} Workout Plan</CardTitle>
          </CardHeader>
          <CardContent>
            <div className="space-y-6">
              {generatedPlan.type === 'Push Pull Legs' && (
                generatedPlan.schedule.map((day, index) => (
                  <div key={index} className="border-b pb-4 last:border-b-0">
                    <h3 className="font-semibold mb-2">Day {index + 1}: {day.type}</h3>
                    <div className="space-y-2">
                      {day.exercises.map((exercise) => (
                        <div key={exercise.id} className="flex justify-between items-center">
                          <span>{exercise.name}</span>
                          <span className="text-gray-600">
                            {exercise.sets} sets × {exercise.reps} reps
                          </span>
                        </div>
                      ))}
                    </div>
                  </div>
                ))
              )}
              {generatedPlan.type === 'Full Body' && (
                generatedPlan.schedule.map((day) => (
                  <div key={day.day} className="border-b pb-4 last:border-b-0">
                    <h3 className="font-semibold mb-2">Day {day.day}</h3>
                    <div className="space-y-4">
                      <div>
                        <h4 className="text-sm font-medium mb-2">Compound Exercises</h4>
                        {day.compound.map((exercise) => (
                          <div key={exercise.id} className="flex justify-between items-center">
                            <span>{exercise.name}</span>
                            <span className="text-gray-600">
                              {exercise.sets} sets × {exercise.reps} reps
                            </span>
                          </div>
                        ))}
                      </div>
                      <div>
                        <h4 className="text-sm font-medium mb-2">Isolation Exercises</h4>
                        {day.isolation.map((exercise) => (
                          <div key={exercise.id} className="flex justify-between items-center">
                            <span>{exercise.name}</span>
                            <span className="text-gray-600">
                              {exercise.sets} sets × {exercise.reps} reps
                            </span>
                          </div>
                        ))}
                      </div>
                    </div>
                  </div>
                ))
              )}
            </div>
            <button
              onClick={() => setStep(3)}
              className="bg-gray-500 text-white px-4 py-2 rounded-md hover:bg-gray-600 transition-colors mt-4"
            >
              Back
            </button>
          </CardContent>
        </Card>
      )}
    </div>
  );
};

export default WorkoutPlanner;
